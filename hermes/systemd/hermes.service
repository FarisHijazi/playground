[Unit]
Description=Hermes Polymarket monitoring bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hermes
EnvironmentFile=/opt/hermes/.env
ExecStart=/opt/hermes/.venv/bin/python -m hermes.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
