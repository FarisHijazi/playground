# Telegram (optional - leave blank to log alerts to stdout instead)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage (optional)
REDIS_URL=redis://localhost:6379

# Comma-separated Polymarket slugs to watch
HERMES_MARKETS=

# Tick intervals in seconds
HERMES_TICK_SEC=180
HERMES_NEWS_TICK_SEC=60

# Trading - leave blank for monitor-only mode
POLY_PRIVATE_KEY=
POLY_FUNDER=
